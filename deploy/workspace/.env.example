# Operator workspace (deploy/workspace/docker-compose.yml). Copy to deploy/workspace/.env (chmod 600). Never commit .env.
# Viewer login (HTTP basic auth on every client browser). Use a long random password: openssl rand -base64 24
WS_VIEWER_USER=julev
WS_VIEWER_PASSWORD=change-me-to-a-long-random-password
# Viewer bind address: 127.0.0.1 = only through the host reverse proxy / an SSH tunnel (recommended).
VIEWER_BIND=127.0.0.1
# Image versions: pin a tested tag once it works (docker image ls lscr.io/linuxserver/chromium).
CHROMIUM_TAG=latest
SOCAT_TAG=1.8.0.3
PUID=1000
PGID=1000
TZ=Asia/Manila
WS_MEM_LIMIT=1536m
# Separate workspace VPS only (docker-compose.remote.yml): this host's WireGuard address, CDP is published there only.
# WG_ADDRESS=10.66.0.2
