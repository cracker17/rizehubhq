# RizeHub HQ environment (copy to .env; never commit real values)
# ---- Supabase ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- AI providers (docs/14). Free to start ----
MODEL_PROFILE=free
MONTHLY_BUDGET_USD=0
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Worker ----
POLL_INTERVAL_MS=3000
MAX_PARALLEL_TASKS=2
TZ=Asia/Manila
VAULT_MASTER_KEY=            # openssl rand -base64 32 (different per environment; back it up offline)
VAULT_KEY_VERSION=1
VAULT_PREVIOUS_KEYS=          # during key rotation: "1:<old base64 key>"
PLAYWRIGHT_CHROMIUM_PATH=     # only if Chromium isn't in the default place
QA_THRESHOLD=85
REPORTS_CHECK_MS=60000
WORKER_HTTP_PORT=4000
HQ_INTERNAL_SECRET=          # openssl rand -hex 32 ; shared by worker (internal API) and dashboard
HQ_WORKER_URL=http://localhost:4000   # production (Docker): http://hq-worker:4000

# ---- RizeHub Agent API (docs/12) ----
RIZEHUB_API_URL=mock          # 'mock' (or empty) = built-in mock RizeHub; staging: http://rizehub-app:8080/agent-api/v1
RIZEHUB_KEY_LEADS=
RIZEHUB_KEY_ONBOARDING=
RIZEHUB_KEY_REPORTS=
RIZEHUB_KEY_READONLY=
RIZEHUB_WEBHOOK_SECRET=
RIZEHUB_JOB_WAIT_MS=45000
RIZEHUB_EVENTS_EVERY_MS=5000
RIZEHUB_JOB_POLL_MS=30000
JOB_FEEDS_EVERY_MS=21600000   # public job feeds every 6 h; 0 = off
JOB_FEEDS=                    # extra RSS feed URLs, comma-separated

# ---- Telegram (use a separate test bot locally) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
DASHBOARD_URL=http://localhost:3000   # production: https://hq.rizehub.ph (also the base of client access links)
TELEGRAM_NOTIFY_CHAT_ID=      # optional; defaults to the first whitelisted user
BOT_POLL_MS=5000
