# RizeHub HQ environment (copy to .env; never commit real values)
# ---- Supabase ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- AI providers (docs/14). Free to start ----
MODEL_PROFILE=free
MONTHLY_BUDGET_USD=0
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Worker ----
POLL_INTERVAL_MS=3000
MAX_PARALLEL_TASKS=2
TZ=Asia/Manila
VAULT_MASTER_KEY=            # openssl rand -base64 32 (different per environment; back it up offline)
QA_THRESHOLD=85
WORKER_HTTP_PORT=4000
HQ_INTERNAL_SECRET=          # openssl rand -hex 32 ; shared by worker (internal API) and dashboard
HQ_WORKER_URL=http://localhost:4000   # production (Docker): http://hq-worker:4000

# ---- RizeHub Agent API (docs/12) ----
RIZEHUB_API_URL=http://localhost:8080/agent-api/v1
RIZEHUB_KEY_LEADS=
RIZEHUB_KEY_ONBOARDING=
RIZEHUB_KEY_REPORTS=
RIZEHUB_KEY_READONLY=
RIZEHUB_WEBHOOK_SECRET=

# ---- Telegram (use a separate test bot locally) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
DASHBOARD_URL=http://localhost:3000
