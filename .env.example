# RizeHub HQ environment. Copy to .env (chmod 600) and fill in. Never commit real values.
# Validate with:  pnpm check:env                 (local .env)
#                 pnpm check:env -- --production  (on the VPS; deploy/setup-vps.sh runs it for you)
# Comments sit on their own lines on purpose: some .env loaders keep "value  # comment" as the value.
# Who reads what:  [D] dashboard  [W] worker  [B] bot  [Br] brain  [ops] deploy/backup scripts only
#
# PRODUCTION: one master .env (this template), split per container so each gets only its own variables:
#     node scripts/split-env.mjs            → .env.dashboard  [D] only: NO service-role key, NO vault key
#                                            .env.bot        [B] only: Supabase service key + Telegram
#                                            .env.worker     [W] + unknown names (per-client tokens), no Telegram/ops
#                                            .env.brain      [Br] only: Supabase service key + BRAIN_* (never the worker's keys)
#     pnpm check:env -- --split --production (fails if a server secret lands in .env.dashboard)
# docker-compose.yml reads those three files; the master .env stays on the host (backup.sh reads [ops] from it).
# setup-vps.sh / update.sh run the split + checks for you. Locally a single .env is fine.

# ======================================================================
# Supabase  (local: `supabase start` prints these; production: Project Settings → API)
# ======================================================================
# [W][B] API URL used server-side. Production: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# [W][B] service_role / secret key. SERVER ONLY: never in the browser, prompts, logs or git.
SUPABASE_SERVICE_ROLE_KEY=
# [D] Same URL + the anon / publishable key. Read at runtime; empty = dashboard runs in DEMO mode (mock data).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ======================================================================
# AI providers (docs/14). Start free: Gemini + Groq + OpenRouter. Paid ones only when MONTHLY_BUDGET_USD > 0.
# ======================================================================
# [W] free | paid | hybrid | claude | openai | kimi  (overrides active_profile in config/models.yaml).
# paid = Anthropic for COO/dev/design/writer/sales + OpenAI for QA (needs ANTHROPIC_API_KEY, OPENAI_API_KEY, MONTHLY_BUDGET_USD > 0).
# kimi = Moonshot Kimi for every role (needs MOONSHOT_API_KEY, MONTHLY_BUDGET_USD > 0).
MODEL_PROFILE=free
# [W] Optional per-role model override, format provider:model (wins over config/models.yaml; empty = use the profile).
# Examples: MODEL_ID_LEAD=anthropic:claude-sonnet-5  MODEL_ID_DESIGN=anthropic:claude-haiku-4-5-20251001  MODEL_ID_QA=openai:gpt-5.5
MODEL_ID_LEAD=
MODEL_ID_DEV=
MODEL_ID_DESIGN=
MODEL_ID_WRITER=
MODEL_ID_SALES=
MODEL_ID_QA=
MODEL_ID_LIGHT=
# Admin → API & AI (dashboard /admin/api) can set the profile, both budgets, per-role models and the provider keys below;
# a value set there wins over this file (docs/14 "Dashboard settings"). Keep the values here as the defaults.
# [W][D] Daily AI spend cap across all agents (USD, Asia/Manila day). 0 = no cap. Telegram alert at 80%; at 100% paid
# providers stop for the day and work falls back to the free profile (free keys set) or waits. The dashboard /costs meter reads it.
DAILY_AI_BUDGET_USD=0
# [W][B] Hard monthly cap for paid providers (USD). 0 = never call Anthropic/OpenAI/Moonshot or paid (non-:free) OpenRouter models.
MONTHLY_BUDGET_USD=0
# [W] https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# [W] https://console.groq.com/keys
GROQ_API_KEY=
# [W] https://openrouter.ai/keys
OPENROUTER_API_KEY=
# [W] paid, optional
ANTHROPIC_API_KEY=
# [W] only for a multi-workspace Anthropic key (personal or service account): the workspace its requests run in, sent as
# the anthropic-workspace-id header (Console → Settings → Workspaces). Leave empty for a key made inside one workspace.
ANTHROPIC_WORKSPACE_ID=
# [W] paid, optional
OPENAI_API_KEY=
# [W] paid, optional: Kimi (Moonshot, https://platform.kimi.ai). Last-resort backup at the end of every "free" role list
# (docs/15 §7); runs only when MONTHLY_BUDGET_USD > 0. New accounts allow 3 requests/minute: top up past tier 0.
MOONSHOT_API_KEY=

# ======================================================================
# Worker runtime
# ======================================================================
# [W] Queue poll interval and parallelism. On a tight VPS use MAX_PARALLEL_TASKS=1.
POLL_INTERVAL_MS=3000
MAX_PARALLEL_TASKS=2
# [W] Per-task caps on the built-in runner (the stricter of these and the role file's max_turns / budget_usd_per_task
#     wins). Over a cap the run stops and the task fails with the reason ("stopped: exceeded max steps 25").
MAX_STEPS_PER_TASK=25
MAX_COST_PER_TASK_USD=1.50
# [W] How often scheduled reports (standups, 08:00 brief, 18:00 digest) are checked.
REPORTS_CHECK_MS=60000
# [W] Minimum QA score (0-100) for a deliverable to pass.
QA_THRESHOLD=85
# [W][B] Time zone for schedules and logs.
TZ=Asia/Manila
# [W] Internal HTTP API port (/health, /chat, vault routes, /hooks/rizehub). Never published publicly.
WORKER_HTTP_PORT=4000
# [D][W] Shared secret for the worker's internal API (header x-hq-secret). Generate: openssl rand -hex 32
HQ_INTERNAL_SECRET=
# [D] Where the dashboard reaches the worker. docker-compose.yml overrides this with http://hq-worker:4000.
HQ_WORKER_URL=http://localhost:4000
# [W] Only if Chromium is not where Playwright expects it (the worker Docker image already has it).
PLAYWRIGHT_CHROMIUM_PATH=
# [W] Unprivileged uid/gid for agent shell commands (bash_sandboxed, git, npm). The worker image sets 1001 and
#     runs the worker as root INSIDE its container only so it can switch agent commands to this uid: agent code
#     then cannot read the worker's secrets (/proc/<pid>/environ). Keep commented out unless you rebuild with other ids.
#     In production the shell refuses to run without this privilege drop or DEV_SANDBOX_PREFIX (docs/09).
# AGENT_UID=1001
# AGENT_GID=1001
# [D][W] Paths. Keep commented out: locally they default to the repo folders, and the Docker images set them.
#     (An empty value is NOT the same as unset for the worker.)
# AGENTS_DIR=/app/agents
# BRAIN_DIR=/app/brain
# WORKSPACES_DIR=/app/workspaces
# MODELS_FILE=/app/config/models.yaml

# ======================================================================
# Research & QA tools (worker, all optional). Without a key the tool tells the agent it is "not connected".
# ======================================================================
# [W] Web search: any one of these (tried in order Tavily → Brave → Serper).
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# [W] Google PageSpeed Insights API key (QA performance evidence; works keyless at low volume).
PAGESPEED_API_KEY=
# [W] SEO data and design files.
SEMRUSH_API_KEY=
FIGMA_TOKEN=
# [W] Image/video/audio generation through your own media gateway. Only MEDIA_PROVIDER=http is implemented.
MEDIA_PROVIDER=
MEDIA_PROVIDER_URL=
MEDIA_PROVIDER_KEY=
# [W] Google APIs (Search Console / Analytics) via an OAuth refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# [W] Upper bound for the automatic QA evidence step (screenshots + PageSpeed), ms.
QA_EVIDENCE_TIMEOUT_MS=150000
# [W] Hosts the fetch/browser tools may reach even though they resolve to private IPs (SSRF guard), comma-separated.
#     Keep empty in production unless you know why (e.g. a staging site on the LAN).
ALLOW_PRIVATE_URLS=
# [W] Binaries. The worker image ships ffmpeg/ffprobe on PATH; set LIGHTHOUSE_CLI only if you build with
#     INSTALL_LIGHTHOUSE=true (otherwise QA uses the PageSpeed API). PLAYWRIGHT_BROWSERS_PATH is set by the image.
LIGHTHOUSE_CLI=
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ======================================================================
# Dev agents (M9): sandboxed shell, GitHub, Shopify theme tools. Platform tokens live in the Client Vault, not here.
# ======================================================================
# [W] Extra hosts the sandboxed shell may reach, comma-separated (defaults: npm registry, GitHub, *.myshopify.com, Webflow API).
DEV_EXTRA_ALLOWED_HOSTS=
# [W] Optional extra OS sandbox wrapper for agent shell commands, as a JSON array, e.g. ["bwrap","--unshare-net","--"].
#     Either this or the AGENT_UID privilege drop (default in the image) must be active in production.
DEV_SANDBOX_PREFIX=
# [W] Shopify Admin API version for theme tools; empty = the tool's built-in default. Format YYYY-MM.
SHOPIFY_API_VERSION=

# ======================================================================
# Client Vault (docs/09). Worker only.
# ======================================================================
# [W] base64 of exactly 32 bytes: openssl rand -base64 32
#     Different per environment. BACK IT UP OFFLINE: losing it makes every stored credential unreadable.
VAULT_MASTER_KEY=
# [W] Version of VAULT_MASTER_KEY (positive integer). Bump when rotating.
VAULT_KEY_VERSION=1
# [W] During rotation only: older keys still needed for reading, e.g. 1:<old base64 key>,2:<older key>
VAULT_PREVIOUS_KEYS=

# ======================================================================
# RizeHub Agent API (docs/12). Worker only.
# ======================================================================
# [W] "mock" (or empty) = built-in mock RizeHub. Staging/production on the shared Docker network:
#     http://rizehub-app:8080/agent-api/v1   (RizeHub outside Docker: http://host.docker.internal:8080/agent-api/v1)
RIZEHUB_API_URL=mock
# [W] One key per scope group, issued by RizeHub. Production HQ = production keys; local HQ = staging keys only.
RIZEHUB_KEY_LEADS=
RIZEHUB_KEY_ONBOARDING=
RIZEHUB_KEY_REPORTS=
RIZEHUB_KEY_READONLY=
# [W] Verifies X-RizeHub-Signature on webhooks to http://hq-worker:4000/hooks/rizehub. openssl rand -hex 32
RIZEHUB_WEBHOOK_SECRET=
# [W] How long a tool waits for a RizeHub job before parking the task until job.completed.
RIZEHUB_JOB_WAIT_MS=45000
# [W] Background loops: webhook event processing, pending-job polling.
RIZEHUB_EVENTS_EVERY_MS=5000
RIZEHUB_JOB_POLL_MS=30000
# [W] Public job feeds import interval (6 h). 0 = off.
JOB_FEEDS_EVERY_MS=21600000
# [W] Extra RSS feed URLs, comma-separated.
JOB_FEEDS=

# ======================================================================
# Sales outreach mailbox (apps/worker/src/sales). Worker only. The Sales Agent only drafts; the worker sends an
# email only after your approval, under the daily cap, with sender name + postal address + opt-out appended.
# ======================================================================
# [W] Master switch for the outreach jobs (send, IMAP replies, daily batch, follow-ups). Off = drafting still works.
OUTREACH_ENABLED=false
# [W] SMTP/IMAP of a SEPARATE, warmed-up outreach domain (never the main domain). Empty = sending / reply reading off.
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASS=
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_PORT=993
OUTREACH_IMAP_USER=
OUTREACH_IMAP_PASS=
# [W] Sender (CAN-SPAM: real name + RizeHub, a valid postal address). Sending is refused while these are missing.
OUTREACH_FROM_NAME=Julev Ajeto, RizeHub
OUTREACH_FROM_EMAIL=
OUTREACH_PHYSICAL_ADDRESS=
# [W] Main domain the From address must NOT be on (default rizehub.ph).
OUTREACH_MAIN_DOMAIN=rizehub.ph
# [W] Daily cap (max 30; OUTREACH_ALLOW_HIGHER_CAP=true for up to 50) and the warm-up ramp (start/day, +step each week).
OUTREACH_DAILY_SEND_CAP=20
OUTREACH_ALLOW_HIGHER_CAP=false
OUTREACH_WARMUP_START=
OUTREACH_WARMUP_START_PER_DAY=10
OUTREACH_WARMUP_STEP_PER_WEEK=5
# [W] Manila hour when the day's drafts become ONE batch approval; optional quiet hours (Manila, e.g. 22-7) with no sending.
OUTREACH_BATCH_HOUR=17
OUTREACH_QUIET_HOURS=
# [W] Unsent follow-ups: auto-approve unflagged ones (flagged emails always need you).
# [W] Optional one-click unsubscribe: public URL of the worker's /hooks/unsubscribe + an HMAC secret (openssl rand -hex 32).
OUTREACH_UNSUBSCRIBE_URL=
OUTREACH_UNSUBSCRIBE_SECRET=
# [W] Loop intervals (ms).
OUTREACH_SEND_EVERY_MS=60000
OUTREACH_IMAP_EVERY_MS=120000

# ======================================================================
# Hermes Agent runtime (deploy/hermes/README.md). Worker; split-env also writes .env.hermes-<agent> from these.
# Leave an agent's values empty and it runs on the built-in runner. Agents: WEB_DEV, DESIGNER, WRITER, SALES.
# ======================================================================
# [W] That agent's Hermes API server (docker: http://hermes-<agent>:8642) and its API_SERVER_KEY (openssl rand -hex 32).
# [W] HQ_MCP_TOKEN_<AGENT>: the token that agent's Hermes sends to the worker's /mcp endpoint (openssl rand -hex 32).
# [W] HERMES_MODEL_<AGENT>: optional per-agent model id (overrides HERMES_MODEL).
HERMES_URL_WEB_DEV=
HERMES_KEY_WEB_DEV=
HQ_MCP_TOKEN_WEB_DEV=
# HERMES_MODEL_WEB_DEV=
HERMES_URL_DESIGNER=
HERMES_KEY_DESIGNER=
HQ_MCP_TOKEN_DESIGNER=
# HERMES_MODEL_DESIGNER=
HERMES_URL_WRITER=
HERMES_KEY_WRITER=
HQ_MCP_TOKEN_WRITER=
# HERMES_MODEL_WRITER=
HERMES_URL_SALES=
HERMES_KEY_SALES=
HQ_MCP_TOKEN_SALES=
# HERMES_MODEL_SALES=
# [W] Model the Hermes instances run (config.yaml model.default); the worker prices their usage with it.
#     OpenRouter ids are vendor/model, e.g. moonshotai/kimi-k2.6 or anthropic/claude-sonnet-5 (uses OPENROUTER_API_KEY).
HERMES_MODEL=
# [W] Hermes model provider: openrouter (default) | anthropic | openai. The matching *_API_KEY above must be set.
HERMES_PROVIDER=openrouter
# [ops] Model for Hermes' own side tasks (titles, summaries, memory upkeep, vision): keep it cheap. Empty = HERMES_MODEL.
#       Only the .env.hermes-<agent> files get it.
HERMES_AUX_MODEL=google/gemini-2.5-flash-lite
# [ops] Optional OpenRouter key for Hermes only. Give it a credit limit on openrouter.ai → Keys: that is the hard stop
#       for Hermes spend (side tasks aren't in HQ's cost records). Empty = OPENROUTER_API_KEY. Never in a service file.
HERMES_OPENROUTER_API_KEY=
# [W] on = run a task on the built-in runner when its agent's Hermes is not configured, unhealthy, down or times out
#     (logged as "Hermes unavailable for <agent>, ran on the built-in runner (<reason>)"). off = re-queue instead.
HERMES_FALLBACK=on
# [W] Max wait for one Hermes task run, ms (default 30 min).
HERMES_TIMEOUT_MS=1800000

# ======================================================================
# Claude Agent SDK runtime (docs/05 "Claude runtime"). Worker only. Off by default: an agent runs on Claude only when
# its role file says `runtime: claude`, this switch is on, ANTHROPIC_API_KEY is set (an Anthropic Console API key, never
# a claude.ai login) and MONTHLY_BUDGET_USD > 0. Otherwise (or when a run fails / times out) it runs on the built-in runner.
# ======================================================================
# [W] true = let `runtime: claude` agents run on the Claude Agent SDK.
CLAUDE_RUNTIME_ENABLED=false
# [W] hq = files through HQ's workspace_fs tool (race-safe jail, default); native = Claude Code's own Read/Edit/Write/Glob/Grep,
#     confined to the task workspace by a hook (runs as the worker uid; see docs/05 before choosing it).
CLAUDE_FILE_TOOLS=hq
# [W] Max wait for one Claude task run, ms (default 30 min).
CLAUDE_TIMEOUT_MS=1800000
# [W] Optional: the worker's own HQ MCP endpoint as seen from inside the container (default http://127.0.0.1:<WORKER_HTTP_PORT>/mcp).
# CLAUDE_HQ_MCP_URL=
# [W] Optional Anthropic model id for all Claude runs / one agent (default: the role's Anthropic model in config/models.yaml,
#     else the `claude` profile). Agents: COO, WEB_DEV, DESIGNER, WRITER, SALES, QA_LEAD.
# CLAUDE_MODEL=
# CLAUDE_MODEL_COO=
# CLAUDE_MODEL_WEB_DEV=
# CLAUDE_MODEL_DESIGNER=
# CLAUDE_MODEL_WRITER=
# CLAUDE_MODEL_SALES=
# CLAUDE_MODEL_QA_LEAD=

# ======================================================================
# HQ Brain (docs/16-BRAIN.md): container hq-brain mirrors the memory vault repo and indexes it into Supabase.
# The worker never gets these secrets (it runs agent code). Generate secrets with: openssl rand -hex 32
# ======================================================================
# [D][Br] dashboard → brain internal API. docker-compose.yml sets BRAIN_URL=http://hq-brain:4100 in production.
BRAIN_INTERNAL_SECRET=
# BRAIN_URL=http://127.0.0.1:4100
# [Br] Secret of the GitHub webhook on the vault repo (push → https://hq.rizehub.ph/api/brain/github)
BRAIN_WEBHOOK_SECRET=
# [Br] Vault repo, cloned over SSH with a deploy key (deploy/brain-setup.sh creates secrets/brain_deploy_key)
BRAIN_REPO_URL=git@github.com:cracker17/claude-memory-vault.git
# BRAIN_REPO_BRANCH=main
# [Br] OpenAI key for embeddings ONLY (give it its own spend limit). Empty = keyword-only search.
BRAIN_OPENAI_API_KEY=
# [Br] Optional overrides: BRAIN_EMBED_MODEL=openai:text-embedding-3-small · BRAIN_POLL_SECONDS=300 · BRAIN_HTTP_PORT=4100
# BRAIN_EMBED_MODEL=
# BRAIN_POLL_SECONDS=300
# BRAIN_HTTP_PORT=4100
# [Br] Brain connector (M14.2, https://hq.rizehub.ph/mcp/brain): OAuth clients may redirect to claude.ai / claude.com and
# loopback (Claude Code) only; add more https hosts comma-separated. Dates written into the vault use BRAIN_TIMEZONE.
# BRAIN_OAUTH_REDIRECT_HOSTS=
# BRAIN_TIMEZONE=Asia/Manila
# Set by the brain image / docker-compose.yml (leave commented):
# BRAIN_VAULT_DIR=/data/vault
# BRAIN_DEPLOY_KEY_PATH=/run/secrets/brain_deploy_key
# BRAIN_KNOWN_HOSTS_PATH=/run/secrets/brain_known_hosts

# ======================================================================
# Telegram (docs/08). Use a separate TEST bot locally; the production token only lives on the VPS.
# ======================================================================
# [B] From @BotFather
TELEGRAM_BOT_TOKEN=
# [B] Your numeric Telegram user id(s), comma-separated (ask @userinfobot). Only these can command the bot.
TELEGRAM_ALLOWED_USER_IDS=
# [B] Optional; defaults to the first whitelisted user.
TELEGRAM_NOTIFY_CHAT_ID=
# [B] How often the bot checks for new notifications (ms, >= 1000).
BOT_POLL_MS=5000
# [D][B] Public dashboard URL (links in Telegram messages and client access links). Production: https://hq.rizehub.ph
DASHBOARD_URL=http://localhost:3000

# ======================================================================
# Ops (deploy/backup.sh only; not read by the apps)
# ======================================================================
# [ops] Postgres connection string for pg_dump. Supabase → Connect → Session pooler (IPv4), e.g.
#       postgresql://postgres.<ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# [ops] Where backups go and how many days to keep them.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14

# ======================================================================
# Dev tools only (pnpm --filter worker mock:rizehub / contract:rizehub). Not needed in production.
# ======================================================================
# MOCK_RIZEHUB_PORT=8080
# MOCK_RIZEHUB_HOST=0.0.0.0
# HQ_WEBHOOK_URL=http://localhost:4000/hooks/rizehub
# RIZEHUB_CHECK_WORKSPACE=
# RIZEHUB_CHECK_ACCOUNT=
# Office asset base for standalone dashboard previews (build-time; default /office).
# NEXT_PUBLIC_OFFICE_ASSETS=./office
